{
  "manifest_version": 3,
  "name": "浏览行为分析器",
  "version": "0.1.0",
  "description": "只在本地统计浏览历史、活跃时长、站点排行和成就进度的 Chrome 扩展。",
  "action": {
    "default_title": "浏览行为分析器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "options_page": "options.html",
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开浏览行为分析器历史仪表盘"
    }
  }
}
